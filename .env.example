# ==================================================
# VIGÍA
# ==================================================
APP_ENV=development
APP_NAME=VIGIA

# ==================================================
# FRONTEND
# ==================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==================================================
# SUPABASE
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# ==================================================
# AEMET
# ==================================================
AEMET_API_KEY=

# ==================================================
# NASA FIRMS
# ==================================================
NASA_FIRMS_MAP_KEY=

# ==================================================
# COPERNICUS DATA SPACE / SENTINEL HUB
# ==================================================
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_SH_BASE_URL=https://sh.dataspace.copernicus.eu

# Local geospatial storage (raw/processed/cache remain ignored by Git)
GEOSPATIAL_STORAGE_ROOT=data

# ==================================================
# EUMETSAT
# ==================================================
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# MTG FCI Active Fire Monitoring netCDF
EUMETSAT_MTG_FIR_COLLECTION=EO:EUM:DAT:0682

# ==================================================
# DATA
# ==================================================
DATA_ROOT=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
MODEL_DATA_PATH=./data/models
CACHE_DATA_PATH=./data/cache

# ==================================================
# VIGÍA
# ==================================================
VIGIA_DEFAULT_COUNTRY=ES
VIGIA_DEFAULT_REGION=Castilla y León
VIGIA_DEFAULT_PROVINCE=Ávila

VIGIA_ENABLE_LIVE_DATA=true
VIGIA_ENABLE_HISTORICAL_REPLAY=true
VIGIA_ENABLE_EXPERIMENTAL_FORECASTS=true
VIGIA_CODE_COMMIT=

# ==================================================
# SECURITY
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
